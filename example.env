# dying-light-nex — example configuration.
# Copy to ".env" and fill in real values. NEVER commit your real .env.

# --- Network ---
# IP/hostname that clients will use to reach the secure server.
# For local testing use your PC's LAN IP (e.g. 192.168.1.10), NOT 127.0.0.1
# if the Switch is on the same network.
NEXTENDO_HOST=192.168.137.1
AUTH_PORT=443
SECURE_PORT=60010

# TLS certificates (self-signed is fine for private testing)
CERT_FILE=certs/server.crt
KEY_FILE=certs/server.key

# Set to 1 if this server sits behind a proxy that speaks the PROXY protocol.
NEXTENDO_PROXY_PROTOCOL=0

# --- Nextendo account integration (optional for private testing) ---
NEXTENDO_ACCOUNT_URL=https://nextendo.network
# 0 = allow guest/anonymous logins (recommended for first tests)
# 1 = require a valid Nextendo account token
NEXTENDO_REQUIRE_ACCOUNT=0
NEXTENDO_REQUIRE_SIGNED_TOKEN=0

# --- Secrets ---
NEXTENDO_INTERNAL_KEY=change-me-to-a-long-random-string
NEXTENDO_SECRET=change-me-to-a-long-random-string
NEXTENDO_SECRET_FILE=
NEXTENDO_SECURE_PASSWORD=securepasswordplz1
NEXTENDO_SNI_HOST=g27332e00-lp1.s.n.srv.nintendo.net
